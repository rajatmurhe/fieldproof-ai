# Backend — copy to .env and fill in. Everything here runs on free tiers.

DATABASE_URL=postgresql+psycopg2://postgres:postgrespassword@localhost:5433/fieldproof
GEMINI_API_KEY=
CLERK_SECRET_KEY=
# Comma-separated frontend origins (used for CORS and Clerk token checks)
CORS_ALLOWED_ORIGINS=http://localhost:3000
CLERK_AUTHORIZED_PARTIES=http://localhost:3000

# Optional: override Gemini models without a code change
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite

# Optional: PASS/FAIL below this confidence is sent to human review (default 0.5)
# GUARDRAIL_MIN_CONFIDENCE=0.5

# Optional: run the analysis worker inside the API process (free hosting)
# RUN_WORKER_IN_PROCESS=true

# Optional: durable video storage (Supabase free tier). Local disk is used
# when these are unset.
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=
# SUPABASE_BUCKET=videos
# UPLOAD_DIR=uploads
